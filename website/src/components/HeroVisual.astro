---
// The signature hero board (DESIGN_SPEC §6, §9). A premium gradient-lit frame
// today — drop in the real 2× dark-mode board screenshot later via `image`.
// That single prop is the whole swap seam; the interior is the only thing it
// replaces. No fabricated product UI: the placeholder is an abstract glowing
// canvas, clearly a frame, not the app.
interface Props {
  /** Path/URL to the real 2× dark-mode board screenshot. Omit for the placeholder. */
  image?: string;
  alt?: string;
}
const { image, alt = 'TrustFlow board' } = Astro.props;
---

<div class="board-frame">
  <div class="board">
    {
      image ? (
        <img
          src={image}
          alt={alt}
          width="1600"
          height="1000"
          loading="eager"
          class="board-img"
        />
      ) : (
        <div class="board-canvas" aria-hidden="true">
          <span class="board-grid"></span>
          <span class="board-sheen"></span>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Gradient-lit 1px frame — top edge tinted with the aurora's indigo light. */
  .board-frame {
    position: relative;
    padding: 1px;
    border-radius: calc(var(--radius-card) + 1px);
    background: linear-gradient(
      180deg,
      rgba(180, 178, 255, 0.4),
      rgba(255, 255, 255, 0.05) 24%,
      rgba(255, 255, 255, 0.02)
    );
  }

  /* A bright, blurred light line skimming the very top edge — the aurora
     catching the screen's bezel. */
  .board-frame::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--accent-hover), 0.9),
      transparent
    );
    filter: blur(1px);
  }

  .board {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: rgb(var(--surface-card));
  }

  .board-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top center;
  }

  /* Abstract placeholder canvas: a workspace lit from behind, not an empty box. */
  .board-canvas {
    position: relative;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(130% 90% at 50% -12%, rgba(var(--accent), 0.16), transparent 58%),
      linear-gradient(180deg, rgb(var(--bg-raised)), rgb(var(--surface-card)));
  }

  /* Dot grid, fading out from the top — reads as canvas, faces no glyphs. */
  .board-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(120% 85% at 50% 0%, #000 32%, transparent 74%);
    mask-image: radial-gradient(120% 85% at 50% 0%, #000 32%, transparent 74%);
  }

  /* A soft highlight sweeping across the top edge, catching the aurora light. */
  .board-sheen {
    position: absolute;
    inset: 0 0 auto 0;
    height: 40%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent);
  }

  @media (min-width: 768px) {
    .board-canvas {
      aspect-ratio: 16 / 8.5;
    }
  }
</style>
