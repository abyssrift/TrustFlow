---
// Shared top navigation (DESIGN_SPEC §1, PLAN §2.1).
// Sticky, frosted, hairline bottom border. No JS: the frosted bar reads well
// at any scroll position, so the optional transparent-on-scroll swap is skipped.
const APP_URL = 'https://portal.trustedgellc.com';

const links = [
  { label: 'Product', href: '/product' },
  { label: 'Plans', href: '/plans' },
  { label: 'Resources', href: '/resources' },
];
---

<header
  class="sticky top-0 z-50 border-b border-hairline bg-bg-base/70 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-content items-center justify-between gap-6 px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-md text-text-main"
      aria-label="TrustFlow home"
    >
      <img src="/logo-mark-white.png" alt="" width="26" height="26" class="h-[26px] w-[26px]" />
      <span class="text-[1.0625rem] font-semibold tracking-tight">TrustFlow</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[0.9375rem] text-text-muted transition-colors duration-200 hover:text-text-main"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={APP_URL}
        class="hidden text-[0.9375rem] font-medium text-text-muted transition-colors duration-200 hover:text-text-main sm:inline-flex"
      >
        Sign in
      </a>
      <a href={APP_URL} class="btn btn-primary">Get started</a>
    </div>
  </nav>
</header>
