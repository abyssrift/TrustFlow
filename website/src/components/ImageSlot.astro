---
// Product screenshot/mockup slot. Renders the 3-layer ambient-glow +
// contact-shadow treatment from the design handoff, wrapping either a real
// image (when `src` is set) or a labeled placeholder box (when it isn't),
// so page layout is provable before real assets land.
//
// `src` takes either an imported asset (goes through astro:assets — auto
// avif/webp + responsive srcset) or a `public/shots/...` path string (no
// import, no build step — the right tradeoff for slots like docs/content-hub
// whose images come from data, not a static import list).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  height: number;
  variant?: 'hero' | 'feature' | 'testimonial' | 'avatar';
  class?: string;
  src?: ImageMetadata | string;
  /** Alt text. Falls back to `label`. Pass "" for purely decorative shots. */
  alt?: string;
  /**
   * Flat screenshot (no device frame) — gets the hairline border + card
   * radius from DESIGN_SPEC §6. Transparent device mockups must NOT set
   * this: their frame is part of the image, so a border would draw a box
   * around the empty space surrounding the laptop.
   */
  framed?: boolean;
}

const { label, height, variant = 'feature', class: className = '', src, alt, framed = false } = Astro.props;
const altText = alt ?? label;

const glowByVariant = {
  hero: { ambient: '70% -10% 40px 0.22', mid: '52% 6% 24px 0.17', contactH: 44, contactBlur: 16, contactOpacity: 0.72 },
  feature: { ambient: '65% -10% 34px 0.2', mid: '48% 8% 20px 0.15', contactH: 36, contactBlur: 14, contactOpacity: 0.68 },
  testimonial: { ambient: '65% -10% 34px 0.2', mid: null, contactH: 28, contactBlur: 12, contactOpacity: 0.6 },
  avatar: null,
} as const;

const glow = glowByVariant[variant];
---

{
  variant === 'avatar' ? (
    src ? (
      <img
        src={src}
        alt={altText}
        width={height}
        height={height}
        loading="lazy"
        class:list={['flex-none rounded-full object-cover', className]}
        style={{ width: `${height}px`, height: `${height}px` }}
      />
    ) : (
      <div
        class:list={['flex flex-none items-center justify-center rounded-full border border-hairline bg-surface-card text-[10px] text-text-faint', className]}
        style={{ width: `${height}px`, height: `${height}px` }}
      >
        {label}
      </div>
    )
  ) : (
    <div class:list={['relative min-w-0', className]}>
      {glow && (() => {
        const [ambientH, ambientTop, ambientBlur, ambientOpacity] = glow.ambient.split(' ');
        return (
          <div
            aria-hidden="true"
            class="pointer-events-none absolute left-[2%] right-[2%] z-0"
            style={{
              top: ambientTop,
              height: ambientH,
              filter: `blur(${ambientBlur})`,
              background: `radial-gradient(closest-side, rgba(180,195,215,${ambientOpacity}), rgba(180,195,215,0) 70%)`,
            }}
          />
        );
      })()}
      {glow?.mid && (() => {
        const [midH, midTop, midBlur, midOpacity] = glow.mid.split(' ');
        return (
          <div
            aria-hidden="true"
            class="pointer-events-none absolute left-[8%] right-[8%] z-0"
            style={{
              top: midTop,
              height: midH,
              filter: `blur(${midBlur})`,
              background: `radial-gradient(closest-side, rgba(215,228,242,${midOpacity}), rgba(215,228,242,0) 65%)`,
            }}
          />
        );
      })()}
      {glow && (
        <div
          aria-hidden="true"
          class="pointer-events-none absolute bottom-0 left-[10%] right-[10%] z-0"
          style={{
            height: `${glow.contactH}px`,
            filter: `blur(${glow.contactBlur}px)`,
            background: `radial-gradient(closest-side, rgba(0,0,0,${glow.contactOpacity}), rgba(0,0,0,0) 75%)`,
          }}
        />
      )}
      {src ? (
        /* Real assets size from their own aspect ratio (w-full + h-auto)
           rather than the slot's `height`, which would letterbox a
           transparent device mockup inside a fixed box and leave dead
           space. `height` still governs the placeholder below, and
           max-height keeps an unusually tall asset from blowing out the
           section. Device mockups are transparent PNGs, so no rounding —
           the frame is part of the image. */
        typeof src === 'string' ? (
          <img
            src={src}
            alt={altText}
            loading={variant === 'hero' ? 'eager' : 'lazy'}
            fetchpriority={variant === 'hero' ? 'high' : undefined}
            decoding="async"
            class:list={[
              'relative z-10 h-auto w-full object-contain',
              framed && 'rounded-card border border-hairline',
            ]}
            style={{ maxHeight: `${Math.round(height * 1.4)}px` }}
          />
        ) : (
          <Image
            src={src}
            alt={altText}
            loading={variant === 'hero' ? 'eager' : 'lazy'}
            class:list={[
              'relative z-10 h-auto w-full object-contain',
              framed && 'rounded-card border border-hairline',
            ]}
            style={{ maxHeight: `${Math.round(height * 1.4)}px` }}
          />
        )
      ) : (
        <div
          class="relative z-10 flex w-full items-center justify-center rounded-card border border-dashed border-hairline-strong bg-surface-card px-6 text-center text-[13px] text-text-faint"
          style={{ height: `${height}px` }}
        >
          {label}
        </div>
      )}
    </div>
  )
}
