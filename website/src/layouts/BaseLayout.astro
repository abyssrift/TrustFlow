---
import '../styles/global.css';
// Self-host Inter + Inter Tight (latin subset only) straight from the
// @fontsource deps. Vite emits hashed URLs we can both @font-face and
// preload — one weight axis, one file each, font-display: swap.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Absolute URL to a 1200x630 OG image; falls back to the site default. */
  ogImage?: string;
}

const { title, description, ogImage = '/og-default.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const unicodeRangeLatin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const interFontFace = `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${unicodeRangeLatin};}`;
const interTightFontFace = `@font-face{font-family:'Inter Tight Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interTightLatin}) format('woff2-variations');unicode-range:${unicodeRangeLatin};}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />
    <style set:html={interFontFace}></style>
    <style set:html={interTightFontFace}></style>

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <slot />
    <div id="site-cursor" aria-hidden="true"></div>
    <script is:inline>
      // Site-wide scroll-reveal: elements marked .reveal or .word-reveal
      // animate in the first time they enter the viewport. Gated behind a
      // JS-added class so content is never hidden without JS, and behind
      // prefers-reduced-motion in CSS so motion-sensitive users just see
      // content in place.
      document.documentElement.classList.add('js-reveal-ready');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal, .word-reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal, .word-reveal').forEach((el) => el.classList.add('is-visible'));
      }

      // Custom cursor — only on fine pointers with motion allowed, so touch
      // devices and reduced-motion users just get the native cursor.
      const wantsCursor =
        window.matchMedia('(pointer: fine)').matches &&
        window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      if (wantsCursor) {
        document.documentElement.classList.add('has-custom-cursor');
        const cursor = document.getElementById('site-cursor');
        window.addEventListener(
          'mousemove',
          (e) => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
          },
          { passive: true }
        );
        document.addEventListener('mouseover', (e) => {
          cursor.classList.toggle('is-hover', !!e.target.closest('a, button, [data-cursor-hover]'));
        });
      }

      // Spotlight — any [data-spotlight] element gets a cursor-tracking
      // light (see .spotlight/.gradient-border in global.css for the paint).
      document.querySelectorAll('[data-spotlight], .gradient-border').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--x', e.clientX - r.left + 'px');
          el.style.setProperty('--y', e.clientY - r.top + 'px');
        });
      });

      // Magnetic buttons — any .magnetic element leans toward the cursor
      // within a small padded zone, site-wide, no per-page wiring needed.
      if (window.matchMedia('(pointer: fine)').matches && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const PAD = 44;
        window.addEventListener(
          'mousemove',
          (e) => {
            document.querySelectorAll('.magnetic').forEach((el) => {
              const r = el.getBoundingClientRect();
              const cx = r.left + r.width / 2;
              const cy = r.top + r.height / 2;
              const dx = e.clientX - cx;
              const dy = e.clientY - cy;
              const within =
                e.clientX > r.left - PAD && e.clientX < r.right + PAD && e.clientY > r.top - PAD && e.clientY < r.bottom + PAD;
              el.style.transform = within ? `translate(${dx * 0.25}px, ${dy * 0.25}px)` : 'translate(0,0)';
            });
          },
          { passive: true }
        );

        // Card tilt — subtle 3D lean toward the cursor.
        document.querySelectorAll('.tilt-card').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `perspective(700px) rotateX(${py * -6}deg) rotateY(${px * 6}deg)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = 'perspective(700px) rotateX(0) rotateY(0)';
          });
        });
      }
    </script>
  </body>
</html>
