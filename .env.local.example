# Committed copy of .env.local — restored by `npm run env:local`.
# Points the app at the local Supabase dev stack (npx supabase start) instead of prod.
# Expo loads this file with higher priority than .env, so these two keys override —
# everything else (VAPID key, APP_URL) still falls back to .env.
# These are Supabase's standard local-dev demo keys, not secrets — same for every
# `supabase start` on every machine.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
