# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
# ".env*.local" only matches names starting with ".env" — prefixed ones like
# supabase/functions.env.local (live Paymob/Jira/Resend/VAPID secrets) slip past it.
*.env.local

# Local Supabase stack — see docs/LOCAL_SUPABASE_DEV.md (on local-supabase-dev-env).
# seed.sql is a full prod data dump containing real customer records (names,
# emails). It is passed between developers out-of-band, NEVER through git.
supabase/seed.sql
# Supabase CLI local state: linked project ref, pooler URL, container versions,
# and .temp/start-secrets/ (local container credentials). Machine-specific and
# rewritten on every `supabase start`.
supabase/.temp/
supabase/.branches/

# one-off design export, not a source file
website/TrustFlow website design/waitlist_website/

# MCP config (contains API keys)
.mcp.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# graphify AST cache (regenerable via `graphify update .`)
/graphify-out/cache

# generated by lib/imports/testCorpus/generate.ts — the corpus lives in corpus.ts, not as binaries
corpus-out/
