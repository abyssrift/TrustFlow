{
  "description": "TrustFlow repository orientation, UI context, subagent boundaries, and safe command guardrails.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "timeout": 5,
            "statusMessage": "Checking TrustFlow command policy",
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_edit_context.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_edit_context.py\"",
            "timeout": 5,
            "statusMessage": "Checking TrustFlow edit context",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_start.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading TrustFlow subagent boundaries",
            "additionalContextLimit": 1800
          }
        ]
      }
    ]
  }
}
